---
import { site } from "@/data/site";

/** Bare hashes on the homepage, /#hash elsewhere. This is why the header is NOT
    transition:persist'd — a persisted one keeps the previous page's hrefs. */
const onHome = Astro.url.pathname === "/";
const to = (id: string) => (onHome ? `#${id}` : `/#${id}`);

const sections = [
  { id: "about", label: "about" },
  { id: "work", label: "work" },
  { id: "experience", label: "experience" },
  { id: "stack", label: "stack" },
  { id: "contact", label: "contact" },
];
---

<header class="bar">
  {/* Akhil's call. The marks are aria-hidden so screen readers get "akhil",
      not "less than slash akhil greater than". */}
  <a class="brand" href={onHome ? "#main" : "/"}>
    <span class="tagmark" aria-hidden="true">{"</"}</span>{site.shortName.toLowerCase()}<span class="tagmark" aria-hidden="true">{">"}</span>
  </a>

  <nav aria-label="Sections">
    <ul>
      {
        sections.map((s) => (
          <li>
            {/* Kept on one line on purpose — a line break between the slash
                and the label renders as a space, giving "/ about". */}
            <a href={to(s.id)}>
              <span class="tag"><span class="slash" aria-hidden="true">/</span>{s.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {/* Outside <nav>: it isn't navigation, and the scramble targets nav links.
      The label is rewritten by theme.ts to name the theme it switches to. */}
  <button class="theme" type="button" data-theme-toggle aria-label="Switch colour theme">
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
      <circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.2" />
      <path d="M8 1.6a6.4 6.4 0 0 1 0 12.8z" fill="currentColor" />
    </svg>
  </button>
</header>

<style>
  .bar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20; /* under .progress (25) and .skip (30) */
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.25rem;
    /* Full bleed, not the 58rem shell — the name sits at the screen edge. */
    padding-inline: var(--gutter);
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    backdrop-filter: blur(14px) saturate(1.15);
    -webkit-backdrop-filter: blur(14px) saturate(1.15);
    /* Own layer: the backdrop-filter otherwise repaints with the page. */
    transform: translateZ(0);
    will-change: transform;
  }

  /* Without blur support, translucency would just make the text unreadable. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .bar {
      background: color-mix(in srgb, var(--bg) 94%, transparent);
    }
  }

  /* Pushes nav and toggle right together; space-between alone would centre the
     nav between brand and toggle. */
  nav {
    margin-left: auto;
  }

  /* 44px target, but the negative margins keep the visible icon on the gutter
     edge and the nav's rhythm rather than 14px inside it. */
  .theme {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: 0 -14px 0 -0.4rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--faint);
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .theme:hover {
    color: var(--accent);
  }

  .theme:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -6px;
    border-radius: 50%;
  }

  /* The filled half swaps sides with the theme. */
  .theme svg {
    transition: transform 0.45s var(--ease-out);
  }

  :global([data-theme="light"]) .theme svg {
    transform: rotate(180deg);
  }

  /* Exempt from the swap-frame transition kill in global.css — this one is the
     feedback that the click did something. */
  :global(:root[data-theme-switching]) .theme svg {
    transition: transform 0.45s var(--ease-out) !important;
  }

  /* Lower case, not uppercase — uppercase mono at this size read as shouting.
     The name keeps its capital; it's a name, not a path segment. */
  .brand {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .brand:hover {
    color: var(--accent);
  }

  /* No colour of their own: the whole tag shifts to accent together. Hover is a
     colour change, not a reveal. */
  .tagmark {
    color: inherit;
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: 1.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px; /* tap target, even though the bar is shorter visually */
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.01em;
    color: var(--faint);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  /* The slash sits back so the word carries, and it stays out of the
     accessibility tree — screen readers get "about", not "slash about". */
  .slash {
    color: var(--rule);
  }

  nav a:hover .slash,
  nav a.is-active .slash {
    color: var(--accent);
  }

  nav a:hover {
    color: var(--accent);
  }

  /* Underline the text, not the 44px tap target. */
  .tag {
    padding-bottom: 3px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s ease;
  }

  /* Set by the observer in Base.astro as you scroll. */
  nav a.is-active {
    color: var(--accent);
  }

  nav a.is-active .tag {
    border-bottom-color: var(--accent);
  }

  /* Five slashed links need more room than five plain words did. */
  @media (max-width: 44rem) {
    nav ul {
      gap: 0.8rem;
    }

    nav a,
    .brand {
      font-size: 0.75rem;
    }
  }

  /* Phones keep only the two destinations worth a jump. About, Experience and
     Stack are short sections you reach by scrolling anyway, and five items at
     this width crowds the bar into unreadability. */
  @media (max-width: 30rem) {
    nav li:nth-child(1), /* about */
    nav li:nth-child(3), /* experience */
    nav li:nth-child(4) /* stack */ {
      display: none;
    }

    nav ul {
      gap: 1.1rem;
    }

    /* Two items leave room, so the text goes back up rather than down. */
    nav a,
    .brand {
      font-size: 0.8125rem;
    }
  }
</style>
