---
import { site } from "@/data/site";

/**
 * On the homepage the section links are bare hashes, so Lenis intercepts them
 * and scrolls smoothly. From a project page they need the leading slash or they
 * point at anchors that don't exist there.
 *
 * This is why the header is NOT transition:persist'd — the hrefs depend on which
 * page rendered it, and a persisted header would keep the previous page's set.
 */
const onHome = Astro.url.pathname === "/";
const to = (id: string) => (onHome ? `#${id}` : `/#${id}`);

const sections = [
  { id: "about", label: "about" },
  { id: "work", label: "work" },
  { id: "experience", label: "experience" },
  { id: "stack", label: "stack" },
  { id: "contact", label: "contact" },
];
---

<header class="bar">
  {/* Akhil's call. The marks are aria-hidden so screen readers get "akhil",
      not "less than slash akhil greater than". */}
  <a class="brand" href={onHome ? "#main" : "/"}>
    <span class="tagmark" aria-hidden="true">{"</"}</span>{site.shortName.toLowerCase()}<span class="tagmark" aria-hidden="true">{">"}</span>
  </a>

  <nav aria-label="Sections">
    <ul>
      {
        sections.map((s) => (
          <li>
            {/* Kept on one line on purpose — a line break between the slash
                and the label renders as a space, giving "/ about". */}
            <a href={to(s.id)}>
              <span class="tag"><span class="slash" aria-hidden="true">/</span>{s.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .bar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20; /* under .progress (25) and .skip (30) */
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.25rem;
    /* Full bleed, not the 58rem shell — the name sits at the screen edge. */
    padding-inline: var(--gutter);
    border-bottom: 1px solid var(--rule);
    background: rgba(21, 23, 26, 0.55);
    backdrop-filter: blur(14px) saturate(1.15);
    -webkit-backdrop-filter: blur(14px) saturate(1.15);
  }

  /* Without blur support, translucency would just make the text unreadable. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .bar {
      background: rgba(21, 23, 26, 0.94);
    }
  }

  /* Lower case, not uppercase — uppercase mono at this size read as shouting.
     The name keeps its capital; it's a name, not a path segment. */
  .brand {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .brand:hover {
    color: var(--accent);
  }

  /* No colour of their own. The whole tag reads as one thing at rest and the
     entire thing shifts to accent on hover — hover is a colour change, not a
     reveal. (These were --rule once, which made them near-invisible until you
     pointed at the bar.) */
  .tagmark {
    color: inherit;
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: 1.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px; /* tap target, even though the bar is shorter visually */
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.01em;
    color: var(--faint);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  /* The slash sits back so the word carries, and it stays out of the
     accessibility tree — screen readers get "about", not "slash about". */
  .slash {
    color: var(--rule);
  }

  nav a:hover .slash,
  nav a.is-active .slash {
    color: var(--accent);
  }

  nav a:hover {
    color: var(--accent);
  }

  /* Underline the text, not the 44px tap target. */
  .tag {
    padding-bottom: 3px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s ease;
  }

  /* Set by the observer in Base.astro as you scroll. */
  nav a.is-active {
    color: var(--accent);
  }

  nav a.is-active .tag {
    border-bottom-color: var(--accent);
  }

  /* Five slashed links need more room than five plain words did. */
  @media (max-width: 44rem) {
    nav ul {
      gap: 0.8rem;
    }

    nav a,
    .brand {
      font-size: 0.75rem;
    }
  }

  /* Phones keep only the two destinations worth a jump. About, Experience and
     Stack are short sections you reach by scrolling anyway, and five items at
     this width crowds the bar into unreadability. */
  @media (max-width: 30rem) {
    nav li:nth-child(1), /* about */
    nav li:nth-child(3), /* experience */
    nav li:nth-child(4) /* stack */ {
      display: none;
    }

    nav ul {
      gap: 1.1rem;
    }

    /* Two items leave room, so the text goes back up rather than down. */
    nav a,
    .brand {
      font-size: 0.8125rem;
    }
  }
</style>
