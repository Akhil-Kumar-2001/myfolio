---
import { ClientRouter } from "astro:transitions";
import FlowField from "@/components/FlowField.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { site } from "@/data/site";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Pass a JSON-LD object to inject structured data for this page. */
  schema?: Record<string, unknown>;
  /** Keep the page out of the index — the 404, which isn't a real address. */
  noindex?: boolean;
}

const { title, description, schema, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
/** Bare host for the footer signature — no scheme, no trailing slash. */
const domain = site.url.replace(/^https?:\/\//, "").replace(/\/$/, "");
const ogImage = new URL("/og-image.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* No canonical on the 404: it would invite indexing. */}
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <link rel="canonical" href={canonical} />
      )
    }

    <meta name="theme-color" content="#15171a" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {/* Dimensions declared: LinkedIn and WhatsApp lay the card out before the
        image finishes downloading. */}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={`${site.name} — ${site.role}`} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${site.name} — ${site.role}`} />

    {/* In public/, not astro:assets: <link rel="icon"> needs a stable path.
        Generated from design/fav-icon.png, see design/NOTES.md.
        180 is square and opaque because iOS applies its own squircle mask. */}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <ClientRouter />

    {
      schema && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(schema)}
        />
      )
    }
  </head>
  <body>
    <FlowField />

    <a class="skip" href="#main">Skip to content</a>
    <div class="progress" data-progress aria-hidden="true"></div>
    <SiteHeader />

    <main id="main" class="shell">
      <slot />
    </main>

    <footer class="foot">
      <div class="shell">
        {/* Every claim here is true of this repo. Drop the line if that changes. */}
        <p class="rail built">Built with Astro, three.js, Lenis, custom GLSL.</p>

        {/* The only full name in body copy; keep it findable. Domain derives from
            site.url so the two can't drift. */}
        {/* nowrap spans, or 320px breaks the name in half. */}
        <p class="rail sig">
          &copy; {new Date().getFullYear()} <span class="nb">{site.fullName}</span>
          <span class="nb"><span class="dot" aria-hidden="true">&middot;</span> {domain}</span>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .foot {
    position: relative;
    z-index: 1; /* Above the fixed backdrop. */
    padding-block: 2rem 3rem;
  }

  /* .rail is kept because the scramble targets .foot .rail, but its
     right-alignment and top padding have to be undone here. */
  .foot .rail {
    text-align: left;
    padding-top: 0;
    /* Lower-cased by CSS only: the DOM keeps real casing for search. */
    text-transform: lowercase;
    max-width: none;
  }

  /* balance stops the stack list orphaning "custom glsl." on a phone. NOT on
     .sig — greedy wrapping there is what keeps "© 2026" off a line alone. */
  .foot .built {
    text-wrap: balance;
    margin-bottom: 1.25rem;
  }

  .nb {
    white-space: nowrap;
  }

  .foot .sig {
    color: var(--soft);
  }

  /* --faint, not --rule: the hairline colour reads as no separator at all. */
  .dot {
    margin-right: 0.15em;
    color: var(--faint);
  }

  .foot::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--rule) 10%,
      var(--rule) 90%,
      transparent
    );
  }
</style>

<script>
  import Lenis from "lenis";
  import { initScramble, stopScramble } from "@/scripts/scramble";

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  let lenis: Lenis | null = null;
  let observer: IntersectionObserver | null = null;
  let navObserver: IntersectionObserver | null = null;
  let numObserver: IntersectionObserver | null = null;
  let paintNav: (() => void) | null = null;
  let stopProgress: (() => void) | null = null;

  /* ---- smooth scroll ---- */

  function initScroll() {
    if (reduce || lenis) return;

    lenis = new Lenis({
      duration: 1.05,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
      // Native touch scrolling already feels right; syncing it mostly hurts.
      syncTouch: false,
      // NOT using Lenis's `anchors` option. It swallows the click and sets the
      // hash but silently fails to scroll for some targets — #work and #stack
      // reproduced at 0px every time. Handled explicitly below instead.
    });

    // Lenis is created once and survives view transitions, so this loop runs
    // for the lifetime of the session.
    const loop = (time: number) => {
      lenis?.raf(time);
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }

  /* ---- in-page anchors ---- */

  function onAnchorClick(e: MouseEvent) {
    // Without Lenis (reduced motion), native anchor behaviour already honours
    // scroll-margin-top. Leave it alone.
    if (!lenis) return;
    if (e.defaultPrevented || e.button !== 0) return;
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

    const link = (e.target as Element | null)?.closest?.<HTMLAnchorElement>('a[href^="#"]');
    if (!link) return;
    // The skip link needs native handling so focus actually moves.
    if (link.classList.contains("skip")) return;

    const id = link.getAttribute("href")?.slice(1);
    if (!id) return;
    const target = document.getElementById(id);
    if (!target) return;

    // Must happen before Astro's router sees the event — see the capture-phase
    // registration below. Once defaultPrevented is set, the router stands down.
    e.preventDefault();

    // No offset: Lenis already subtracts scroll-margin-top, and .band carries
    // 4.5rem. Passing one too undershoots by another 72px.
    const distance = Math.abs(target.getBoundingClientRect().top);
    const duration = Math.min(1.7, Math.max(0.65, distance / 2000));
    lenis.scrollTo(target, { duration });

    // Must carry the EXISTING state through, never pushState(null, ...): Astro
    // keeps {index, scrollX, scrollY} there and the router stops navigating
    // without it. replace, not push, so a nav click adds no history entry.
    history.replaceState(history.state, "", `#${id}`);
  }

  /* Returning to the work grid. The hash alone only lands on the section
     heading, so store the exact position. Must be applied in astro:after-swap —
     earlier hooks get overwritten by the router. */

  const WORK_POS = "work:pos";

  function rememberWorkScroll(e: MouseEvent) {
    if (location.pathname !== "/") return;
    if (e.defaultPrevented || e.button !== 0) return;
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const link = (e.target as Element | null)?.closest?.<HTMLAnchorElement>('a[href^="/work/"]');
    if (!link) return;
    // x is the mobile carousel's own scrollLeft. It's a separate scroll
    // container, so it always comes back showing card one unless we put it back.
    const grid = document.querySelector<HTMLElement>("#work .grid");
    try {
      sessionStorage.setItem(
        WORK_POS,
        JSON.stringify({
          y: Math.round(window.scrollY),
          x: grid ? Math.round(grid.scrollLeft) : 0,
        }),
      );
    } catch {
      /* private mode — fall back to the plain #work landing */
    }
  }

  function restoreWorkScroll() {
    if (location.pathname !== "/") return;

    // Consume on *any* arrival home, not just the "All work" route. Back also
    // brings you home but is restored by Astro's own history scroll state, so
    // it doesn't need the value — and if it were left behind, a later direct
    // visit to a case study would pick up that stale position and jump to it.
    let raw: string | null = null;
    try {
      raw = sessionStorage.getItem(WORK_POS);
      if (raw !== null) sessionStorage.removeItem(WORK_POS);
    } catch {
      return;
    }
    if (raw === null) return;

    let pos: { y?: unknown; x?: unknown };
    try {
      pos = JSON.parse(raw);
    } catch {
      return;
    }
    if (!pos || typeof pos.y !== "number") return;

    // The carousel goes back on every route home, Back included — Astro's
    // history scroll state only covers the page, not a nested scroller.
    const grid = document.querySelector<HTMLElement>("#work .grid");
    if (grid && typeof pos.x === "number" && pos.x > 0) grid.scrollLeft = pos.x;

    // Vertical is only ours on the "All work" route. The brand goes to "/" with
    // no hash and should land at the top; Back is restored by Astro itself.
    if (location.hash !== "#work") return;
    window.scrollTo({ top: pos.y, left: 0, behavior: "instant" as ScrollBehavior });
  }

  /* ---- active section in the nav ---- */

  function initNav() {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(".bar nav a[href*='#']"),
    );
    const byId = new Map<string, HTMLAnchorElement>();
    for (const a of links) {
      const id = a.getAttribute("href")?.split("#")[1];
      if (id) byId.set(id, a);
    }

    const sections = Array.from(byId.keys())
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    navObserver?.disconnect();
    navObserver = null;
    if (!sections.length) return; // project pages have no sections to track

    const seen = new Set<string>();
    const paint = () => {
      // The last section can never reach the detection band — the page runs out
      // of scroll first — so bottom-of-page always means the final section.
      const atBottom =
        Math.ceil(window.scrollY + window.innerHeight) >=
        document.documentElement.scrollHeight - 2;
      // Otherwise first in document order wins, so scrolling down advances
      // predictably rather than flickering between two overlapping sections.
      const active = atBottom
        ? sections[sections.length - 1]!.id
        : (sections.find((s) => seen.has(s.id))?.id ?? null);
      for (const [id, a] of byId) {
        const on = id === active;
        a.classList.toggle("is-active", on);
        if (on) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      }
    };

    navObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) seen.add(entry.target.id);
          else seen.delete(entry.target.id);
        }
        paint();
      },
      // A thin band below the header. Whatever crosses it is "where you are".
      { rootMargin: "-25% 0px -65% 0px" },
    );

    sections.forEach((s) => navObserver!.observe(s));

    // The observer alone can't see "we hit the bottom", so let the progress
    // bar's existing throttled scroll handler drive that case too.
    paintNav = paint;
    paint();
  }

  /* Astro tracks the reload position via `scrollend`, which Lenis swallows with
     stopPropagation. Mobile is where it bites: refreshing landed you somewhere
     random. So write the position ourselves. */
  let reloadPosTimer = 0;

  function rememberScrollForReload() {
    window.clearTimeout(reloadPosTimer);
    reloadPosTimer = window.setTimeout(() => {
      const state = history.state;
      if (!state) return;
      const x = Math.round(window.scrollX);
      const y = Math.round(window.scrollY);
      if (Math.round(state.scrollX ?? -1) === x && Math.round(state.scrollY ?? -1) === y) return;
      history.replaceState({ ...state, scrollX: x, scrollY: y }, "");
    }, 120);
  }

  /* ---- scroll progress ---- */

  function initProgress() {
    const bar = document.querySelector<HTMLElement>("[data-progress]");
    if (!bar) return;

    let queued = false;

    const paint = () => {
      queued = false;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? Math.min(Math.max(window.scrollY / max, 0), 1) : 0;
      bar.style.transform = `scaleX(${ratio})`;
      paintNav?.();
      rememberScrollForReload();
    };

    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(paint);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    paint();

    stopProgress = () => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onScroll);
      stopProgress = null;
    };
  }

  /* ---- scroll reveal ---- */

  // Watches the card numerals, not the cards. The card observer fires on the
  // card's top edge and the numeral is at the bottom, so it spun off screen.
  function initCardNums() {
    if (reduce) return;

    numObserver?.disconnect();
    numObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-in");
          numObserver?.unobserve(entry.target);
        }
      },
      // Most of the numeral has to be on screen, or it spins half out of frame.
      { threshold: 0.6 },
    );

    document.querySelectorAll(".ghost-num").forEach((el) => numObserver!.observe(el));
  }

  function initReveal() {
    // One-shot, not animation-timeline: view() — its range is viewport-relative
    // and anything mid-reveal jumped when mobile chrome hid. See CLAUDE.md.
    if (reduce) return;

    document.documentElement.dataset.revealJs = "";

    observer?.disconnect();
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-in");
          observer?.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
    );

    document.querySelectorAll(".reveal").forEach((el) => observer!.observe(el));
  }

  /* ---- lifecycle ---- */

  // Capture phase, deliberately. Astro's ClientRouter has a bubble-phase click
  // listener on document that preventDefaults same-origin anchors — including
  // in-page hashes — and jumps instantly. Registering on bubble meant it always
  // won and this handler bailed on defaultPrevented. Capture runs first.
  document.addEventListener("click", onAnchorClick, { capture: true });

  // Capture too, so it records the position before the router navigates away.
  document.addEventListener("click", rememberWorkScroll, { capture: true });

  // The router leaves scrollRestoration on "manual", so a reload paints at the
  // top and scrolls after — a visible flash of the hero. Handing it back on the
  // way out lets the browser restore before first paint. SPA swaps never fire
  // pagehide, so the router keeps manual control of those.
  window.addEventListener("pagehide", () => {
    history.scrollRestoration = "auto";
  });

  document.addEventListener("astro:page-load", () => {
    initScroll();
    stopProgress?.();
    initProgress();
    initReveal();
    initCardNums();
    initNav();
    // Last: it reads computed styles and measures text, so let the rest settle
    // first. It gates itself to once per element per session.
    initScramble(reduce);
  });

  document.addEventListener("astro:after-swap", () => {
    // Must run before the Lenis sync below, or Lenis latches onto the router's
    // position and drags us back to it.
    restoreWorkScroll();

    // The document changed height and the browser moved us. Tell Lenis where we
    // actually are rather than letting it animate from a stale position.
    lenis?.resize();

    // stop() + start(), NOT scrollTo(..., { immediate: true }). A Lenis
    // animation surviving the swap writes its old target into the shorter new
    // document and the project opens at its end. scrollTo bails early when the
    // target already equals targetScroll, so it never reaches reset().
    lenis?.stop();
    lenis?.start();
  });

  document.addEventListener("astro:before-swap", () => {
    stopProgress?.();
    observer?.disconnect();
    observer = null;
    navObserver?.disconnect();
    navObserver = null;
    numObserver?.disconnect();
    numObserver = null;
    // Puts any in-flight run back to its original markup. Without this a swap
    // mid-animation would carry half-scrambled text into the next page.
    stopScramble();
  });
</script>
