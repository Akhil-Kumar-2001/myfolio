---
import { ClientRouter } from "astro:transitions";
import FlowField from "@/components/FlowField.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { site } from "@/data/site";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Pass a JSON-LD object to inject structured data for this page. */
  schema?: Record<string, unknown>;
  /** Keep the page out of the index — the 404, which isn't a real address. */
  noindex?: boolean;
}

const { title, description, schema, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
/** Bare host for the footer signature — no scheme, no trailing slash. */
const domain = site.url.replace(/^https?:\/\//, "").replace(/\/$/, "");
const ogImage = new URL("/og-image.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* No canonical on the 404 — a self-referencing canonical claims the URL is
        the authoritative address for this content, which invites indexing of a
        page that stands in for every address that doesn't exist. `follow` so
        the links out of it still pass through. */}
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <link rel="canonical" href={canonical} />
      )
    }

    <meta name="theme-color" content="#15171a" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {/* Dimensions declared because several scrapers — LinkedIn and WhatsApp
        notably — will render a preview from the tags before they finish
        downloading the image, and without these they either lay out the card
        wrong or drop the image. 1200x630 is the 1.91:1 that Open Graph wants. */}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={`${site.name} — ${site.role}`} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${site.name} — ${site.role}`} />

    {/* These live in public/ and are served verbatim — they are NOT run through
        Astro's image pipeline, because a <link rel="icon"> needs a stable path
        and astro:assets would give it a hashed one.

        Cropped and resized from design/fav-icon.png (1254x1254), which is
        gitignored and local only: 650KB is far too heavy to ship for something
        drawn at 16 CSS pixels. design/NOTES.md has the sharp commands.

        The badge is a rounded square, so 32 and 48 carry the rounded shape with
        the corners masked to transparency. 48 as well as 32 because Chrome
        reaches for it in the bookmark and history lists.

        180 is deliberately the odd one out: square, opaque, NOT rounded. iOS
        applies its own squircle mask to an apple-touch-icon, so a pre-rounded
        transparent icon gets clipped twice and looks wrong. It is flattened onto
        black, which is the badge's own background rather than --bg. */}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <ClientRouter />

    {
      schema && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(schema)}
        />
      )
    }
  </head>
  <body>
    <FlowField />

    <a class="skip" href="#main">Skip to content</a>
    <div class="progress" data-progress aria-hidden="true"></div>
    <SiteHeader />

    <main id="main" class="shell">
      <slot />
    </main>

    <footer class="foot">
      <div class="shell">
        {/* Every claim here is true of this repo: Astro builds it, FlowField.astro
            runs three, Lenis drives every scroll, and the backdrop is a
            hand-written vertex/fragment pair fed to ShaderMaterial rather than
            anything off the shelf. Don't leave the line standing if that stops
            being the case. Ordered libraries first, hand-written last. */}
        <p class="rail built">Built with Astro, three.js, Lenis, custom GLSL.</p>

        {/* The hero says "Akhil", so this is the only place a full name appears in
            the body copy — worth keeping for anyone searching it. site.fullName
            spells out the S; site.name keeps the initial for the title and the
            JSON-LD, so both spellings are on the page.

            The domain is derived from site.url so the two can't drift apart. */}
        {/* The name and the domain are each held in a nowrap span. At 320px the
            line has to wrap, and left to itself it broke the name in half —
            "akhil kumar / santhosh". With these, the only break opportunities are
            between the units, so it wraps before the domain and the name stays
            whole. */}
        <p class="rail sig">
          &copy; {new Date().getFullYear()} <span class="nb">{site.fullName}</span>
          <span class="nb"><span class="dot" aria-hidden="true">&middot;</span> {domain}</span>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .foot {
    position: relative;
    z-index: 1; /* Above the fixed backdrop. */
    padding-block: 2rem 3rem;
  }

  /* Two stacked lines, not the .row rail grid the footer used to use. .rail is
     kept as the class so the scramble keeps finding these (it targets
     .foot .rail), but two of its behaviours have to be undone here: it is
     right-aligned above 56rem, which only makes sense in the metadata column,
     and it carried the grid's top padding. */
  .foot .rail {
    text-align: left;
    padding-top: 0;
    /* Displayed lower-case, stored in proper case. Search engines and screen
       readers get "Akhil Kumar Santhosh" and "Astro ... GLSL"; the page shows
       them lower. Same trick as the hero's role line. */
    text-transform: lowercase;
    max-width: none;
  }

  /* The stack list is just long enough to wrap on a phone, and `balance` splits it
     evenly instead of leaving a two-word orphan — it broke after "lenis," and
     dropped "custom glsl." onto a line of its own. Inherited `text-wrap: pretty`
     from the global `p` rule is the fallback where balance isn't supported, so
     this is additive.

     Deliberately NOT on .sig: with the nowrap units below, plain greedy wrapping
     already fills the first line and pushes only the domain down, which is the
     break we want. Balancing it instead risks stranding "© 2026" on a line alone. */
  .foot .built {
    text-wrap: balance;
    margin-bottom: 1.25rem;
  }

  .nb {
    white-space: nowrap;
  }

  .foot .sig {
    color: var(--soft);
  }

  /* --faint, not --rule. --rule is the hairline colour (#2A2D31) and against the
     page it read as no separator at all. This sits just under the signature's
     --soft so it divides without competing. */
  .dot {
    margin-right: 0.15em;
    color: var(--faint);
  }

  .foot::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--rule) 10%,
      var(--rule) 90%,
      transparent
    );
  }
</style>

<script>
  import Lenis from "lenis";
  import { initScramble, stopScramble } from "@/scripts/scramble";

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  let lenis: Lenis | null = null;
  let observer: IntersectionObserver | null = null;
  let navObserver: IntersectionObserver | null = null;
  let paintNav: (() => void) | null = null;
  let stopProgress: (() => void) | null = null;

  /* ---- smooth scroll ---- */

  function initScroll() {
    if (reduce || lenis) return;

    lenis = new Lenis({
      duration: 1.05,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
      // Native touch scrolling already feels right; syncing it mostly hurts.
      syncTouch: false,
      // NOT using Lenis's `anchors` option. It swallows the click and sets the
      // hash but silently fails to scroll for some targets — #work and #stack
      // reproduced at 0px every time. Handled explicitly below instead.
    });

    // Lenis is created once and survives view transitions, so this loop runs
    // for the lifetime of the session.
    const loop = (time: number) => {
      lenis?.raf(time);
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }

  /* ---- in-page anchors ---- */

  function onAnchorClick(e: MouseEvent) {
    // Without Lenis (reduced motion), native anchor behaviour already honours
    // scroll-margin-top. Leave it alone.
    if (!lenis) return;
    if (e.defaultPrevented || e.button !== 0) return;
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

    const link = (e.target as Element | null)?.closest?.<HTMLAnchorElement>('a[href^="#"]');
    if (!link) return;
    // The skip link needs native handling so focus actually moves.
    if (link.classList.contains("skip")) return;

    const id = link.getAttribute("href")?.slice(1);
    if (!id) return;
    const target = document.getElementById(id);
    if (!target) return;

    // Must happen before Astro's router sees the event — see the capture-phase
    // registration below. Once defaultPrevented is set, the router stands down.
    e.preventDefault();

    // No offset here on purpose: Lenis already subtracts the target's
    // scroll-margin-top itself, and .band carries 4.5rem. Passing an offset too
    // would clear the header twice and undershoot by another 72px.
    //
    // Duration scales with distance so a hop to the next section stays quick
    // while a jump from Contact back to the top still reads as travel.
    const distance = Math.abs(target.getBoundingClientRect().top);
    const duration = Math.min(1.7, Math.max(0.65, distance / 2000));
    lenis.scrollTo(target, { duration });

    // replaceState carrying the EXISTING state object through, never
    // pushState(null, ...).
    //
    // Astro keeps {index, scrollX, scrollY} in history.state and its router
    // depends on it. Passing null wiped it, after which clicking a project card
    // silently did nothing — the router could not navigate at all — and Back
    // just walked the browser's hash entries instead.
    //
    // replace rather than push so a nav click doesn't add an entry per section:
    // Back from a case study then returns to the homepage entry itself, whose
    // scroll position we already restore.
    history.replaceState(history.state, "", `#${id}`);
  }

  /* ---- returning to the work grid ----

     "All work" on a case study points at /#work, and Astro's router scrolls to
     the top of the page before applying the hash. That top state is visible, and
     the hash only ever lands you on the section heading — so opening the fourth
     card and coming back dropped you ~580px above where you were.

     Fix: remember the exact position on the way out, put it back on the way in.
     Astro fires astro:after-swap *after* moveToLocation() has done all of its
     own scrolling (router.js:215-216), so setting it there is final. */

  const WORK_POS = "work:pos";

  function rememberWorkScroll(e: MouseEvent) {
    if (location.pathname !== "/") return;
    if (e.defaultPrevented || e.button !== 0) return;
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const link = (e.target as Element | null)?.closest?.<HTMLAnchorElement>('a[href^="/work/"]');
    if (!link) return;
    // x is the mobile carousel's own scrollLeft. It's a separate scroll
    // container, so it always comes back showing card one unless we put it back.
    const grid = document.querySelector<HTMLElement>("#work .grid");
    try {
      sessionStorage.setItem(
        WORK_POS,
        JSON.stringify({
          y: Math.round(window.scrollY),
          x: grid ? Math.round(grid.scrollLeft) : 0,
        }),
      );
    } catch {
      /* private mode — fall back to the plain #work landing */
    }
  }

  function restoreWorkScroll() {
    if (location.pathname !== "/") return;

    // Consume on *any* arrival home, not just the "All work" route. Back also
    // brings you home but is restored by Astro's own history scroll state, so
    // it doesn't need the value — and if it were left behind, a later direct
    // visit to a case study would pick up that stale position and jump to it.
    let raw: string | null = null;
    try {
      raw = sessionStorage.getItem(WORK_POS);
      if (raw !== null) sessionStorage.removeItem(WORK_POS);
    } catch {
      return;
    }
    if (raw === null) return;

    let pos: { y?: unknown; x?: unknown };
    try {
      pos = JSON.parse(raw);
    } catch {
      return;
    }
    if (!pos || typeof pos.y !== "number") return;

    // The carousel goes back on every route home, Back included — Astro's
    // history scroll state only covers the page, not a nested scroller.
    const grid = document.querySelector<HTMLElement>("#work .grid");
    if (grid && typeof pos.x === "number" && pos.x > 0) grid.scrollLeft = pos.x;

    // Vertical is only ours on the "All work" route. The brand goes to "/" with
    // no hash and should land at the top; Back is restored by Astro itself.
    if (location.hash !== "#work") return;
    window.scrollTo({ top: pos.y, left: 0, behavior: "instant" as ScrollBehavior });
  }

  /* ---- active section in the nav ---- */

  function initNav() {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(".bar nav a[href*='#']"),
    );
    const byId = new Map<string, HTMLAnchorElement>();
    for (const a of links) {
      const id = a.getAttribute("href")?.split("#")[1];
      if (id) byId.set(id, a);
    }

    const sections = Array.from(byId.keys())
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    navObserver?.disconnect();
    navObserver = null;
    if (!sections.length) return; // project pages have no sections to track

    const seen = new Set<string>();
    const paint = () => {
      // The last section can never reach the detection band — the page runs out
      // of scroll first — so bottom-of-page always means the final section.
      const atBottom =
        Math.ceil(window.scrollY + window.innerHeight) >=
        document.documentElement.scrollHeight - 2;
      // Otherwise first in document order wins, so scrolling down advances
      // predictably rather than flickering between two overlapping sections.
      const active = atBottom
        ? sections[sections.length - 1]!.id
        : (sections.find((s) => seen.has(s.id))?.id ?? null);
      for (const [id, a] of byId) {
        const on = id === active;
        a.classList.toggle("is-active", on);
        if (on) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      }
    };

    navObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) seen.add(entry.target.id);
          else seen.delete(entry.target.id);
        }
        paint();
      },
      // A thin band below the header. Whatever crosses it is "where you are".
      { rootMargin: "-25% 0px -65% 0px" },
    );

    sections.forEach((s) => navObserver!.observe(s));

    // The observer alone can't see "we hit the bottom", so let the progress
    // bar's existing throttled scroll handler drive that case too.
    paintNav = paint;
    paint();
  }

  /* ---- keep the reload position honest ----

     On a fresh load Astro restores history.state.scrollY (router.js:45). It
     keeps that value current by listening for `scrollend` (router.js:402-412) —
     but Lenis registers its own capture-phase `scrollend` listener on window and
     calls stopPropagation() whenever isScrolling is "smooth" or false, so the
     event can die before Astro ever sees it.

     On desktop that rarely bites: smoothWheel means Lenis drives the scroll and
     dispatches its own CustomEvent scrollend, which its filter lets through. On
     mobile syncTouch is off, so touch scrolling is native and Lenis flips
     isScrolling to false on a 400ms timeout — if the browser's scrollend lands
     after that flip it gets swallowed, history.state goes stale, and refreshing
     drops you back at wherever it last managed to record.

     So write the position ourselves rather than depending on that event. */
  let reloadPosTimer = 0;

  function rememberScrollForReload() {
    window.clearTimeout(reloadPosTimer);
    reloadPosTimer = window.setTimeout(() => {
      const state = history.state;
      if (!state) return;
      const x = Math.round(window.scrollX);
      const y = Math.round(window.scrollY);
      if (Math.round(state.scrollX ?? -1) === x && Math.round(state.scrollY ?? -1) === y) return;
      history.replaceState({ ...state, scrollX: x, scrollY: y }, "");
    }, 120);
  }

  /* ---- scroll progress ---- */

  function initProgress() {
    const bar = document.querySelector<HTMLElement>("[data-progress]");
    if (!bar) return;

    let queued = false;

    const paint = () => {
      queued = false;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? Math.min(Math.max(window.scrollY / max, 0), 1) : 0;
      bar.style.transform = `scaleX(${ratio})`;
      paintNav?.();
      rememberScrollForReload();
    };

    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(paint);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    paint();

    stopProgress = () => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onScroll);
      stopProgress = null;
    };
  }

  /* ---- scroll reveal ---- */

  function initReveal() {
    // Chrome, Edge and Safari drive .reveal from CSS with zero JS. Firefox
    // has no animation-timeline yet, so it gets an observer instead.
    const native = CSS.supports?.("animation-timeline", "view()") ?? false;
    if (native || reduce) return;

    document.documentElement.dataset.revealJs = "";

    observer?.disconnect();
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-in");
          observer?.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
    );

    document.querySelectorAll(".reveal").forEach((el) => observer!.observe(el));
  }

  /* ---- lifecycle ---- */

  // Capture phase, deliberately. Astro's ClientRouter has a bubble-phase click
  // listener on document that preventDefaults same-origin anchors — including
  // in-page hashes — and jumps instantly. Registering on bubble meant it always
  // won and this handler bailed on defaultPrevented. Capture runs first.
  document.addEventListener("click", onAnchorClick, { capture: true });

  // Capture too, so it records the position before the router navigates away.
  document.addEventListener("click", rememberWorkScroll, { capture: true });

  document.addEventListener("astro:page-load", () => {
    initScroll();
    stopProgress?.();
    initProgress();
    initReveal();
    initNav();
    // Last: it reads computed styles and measures text, so let the rest settle
    // first. It gates itself to once per element per session.
    initScramble(reduce);
  });

  document.addEventListener("astro:after-swap", () => {
    // Must run before the Lenis sync below, or Lenis latches onto the router's
    // position and drags us back to it.
    restoreWorkScroll();

    // The document changed height and the browser moved us. Tell Lenis where we
    // actually are rather than letting it animate from a stale position.
    lenis?.resize();

    // stop() + start(), NOT scrollTo(window.scrollY, { immediate: true }).
    //
    // Tapping a card mid-glide leaves a Lenis animation running. If it survives
    // the swap it writes its old target into the new document, and because a
    // case study is far shorter than the homepage (309-743px against ~3300px)
    // that write clamps to the maximum — the project opens at its very end.
    //
    // scrollTo cannot fix it: it bails out early when the requested target
    // equals targetScroll, which resize() has just made true, so it never
    // reaches reset() and the animation keeps running. stop() and start() both
    // go through reset(), which calls animate.stop(). They run synchronously in
    // the same tick, so the lenis-stopped class (overflow: hidden in
    // global.css) is added and removed without a paint in between.
    lenis?.stop();
    lenis?.start();
  });

  document.addEventListener("astro:before-swap", () => {
    stopProgress?.();
    observer?.disconnect();
    observer = null;
    navObserver?.disconnect();
    navObserver = null;
    // Puts any in-flight run back to its original markup. Without this a swap
    // mid-animation would carry half-scrambled text into the next page.
    stopScramble();
  });
</script>
