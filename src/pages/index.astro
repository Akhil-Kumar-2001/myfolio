---
import Base from "@/layouts/Base.astro";
import Hero from "@/components/Hero.astro";
import About from "@/components/About.astro";
import WorkList from "@/components/WorkList.astro";
import Experience from "@/components/Experience.astro";
import StackTable from "@/components/StackTable.astro";
import Contact from "@/components/Contact.astro";
import { site, experience } from "@/data/site";

const current = experience.find((r) => r.current);

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  // The spelled-out name, so a search for it can find this page too.
  alternateName: site.fullName,
  jobTitle: site.role,
  ...(current && {
    worksFor: { "@type": "Organization", name: current.company, url: current.url },
  }),
  url: site.url,
  email: `mailto:${site.email}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Kollam",
    addressRegion: "Kerala",
    addressCountry: "IN",
  },
  sameAs: [site.github, site.linkedin, site.instagram],
};
---

<Base
  title={`${site.shortName} — ${site.role}`}
  description={site.description}
  schema={schema}
>
  <Hero />
  <About />
  <WorkList />
  <Experience />
  <StackTable />
  <Contact />
</Base>
